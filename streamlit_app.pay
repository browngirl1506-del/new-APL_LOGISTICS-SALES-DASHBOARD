import streamlit as st
import pandas as pd
import plotly.express as px
from pathlib import Path

st.set_page_config(
    page_title="APL Logistics Dashboard",
    page_icon="📦",
    layout="wide"
)

st.markdown("""
<style>
.stApp {background-color: #101820; color: #F2F5F7;}
[data-testid="stMetric"] {
    background: #1B2A35;
    padding: 18px;
    border-radius: 12px;
    border: 1px solid #344955;
}
h1, h2, h3 {color: #55D6BE;}
</style>
""", unsafe_allow_html=True)

st.title("📦 APL LOGISTICS")
st.subheader("Sales, Profitability & Shipping Analytics")

# Load data
uploaded_file = st.sidebar.file_uploader(
    "Upload your dataset (Excel or CSV)",
    type=["xlsx", "xls", "csv"]
)

try:
    if uploaded_file is not None:
        if uploaded_file.name.endswith(".csv"):
            df = pd.read_csv(uploaded_file)
        else:
            df = pd.read_excel(uploaded_file)
    elif Path("data.xlsx").exists():
        df = pd.read_excel("data.xlsx")
    elif Path("data.csv").exists():
        df = pd.read_csv("data.csv")
    else:
        st.info("Upload your APL Logistics Excel or CSV file using the sidebar.")
        st.stop()
except Exception as e:
    st.error(f"Could not read the file: {e}")
    st.stop()

# Clean column names
df.columns = df.columns.astype(str).str.strip()

def find_col(possible_names):
    lookup = {c.strip().lower(): c for c in df.columns}
    for name in possible_names:
        if name.lower() in lookup:
            return lookup[name.lower()]
    return None

sales_col = find_col(["Sales", "Sales per customer"])
profit_col = find_col(["Order Profit Per Order", "Benefit per order"])
order_col = find_col(["Order Id", "Order ID"])
quantity_col = find_col(["Order Item Quantity"])
category_col = find_col(["Category Name", "Product Name"])
region_col = find_col(["Order Region", "Market"])
shipping_col = find_col(["Shipping Mode"])
delivery_col = find_col(["Delivery Status"])
late_col = find_col(["Late_delivery_risk"])
date_col = find_col(["order date (DateOrders)", "Order Date"])

# Numeric conversions
for col in [sales_col, profit_col, quantity_col, late_col]:
    if col:
        df[col] = pd.to_numeric(df[col], errors="coerce")

# Sidebar filters
st.sidebar.header("Dashboard Filters")
filtered = df.copy()

if region_col:
    regions = sorted(filtered[region_col].dropna().astype(str).unique())
    selected_regions = st.sidebar.multiselect(
        "Select Region", regions, default=regions
    )
    filtered = filtered[
        filtered[region_col].astype(str).isin(selected_regions)
    ]

if category_col:
    categories = sorted(filtered[category_col].dropna().astype(str).unique())
    selected_categories = st.sidebar.multiselect(
        "Select Category / Product", categories
    )
    if selected_categories:
        filtered = filtered[
            filtered[category_col].astype(str).isin(selected_categories)
        ]

# KPI calculations
total_sales = filtered[sales_col].sum() if sales_col else 0
total_profit = filtered[profit_col].sum() if profit_col else 0
total_orders = (
    filtered[order_col].nunique()
    if order_col else len(filtered)
)
total_quantity = filtered[quantity_col].sum() if quantity_col else 0

a, b, c, d = st.columns(4)
a.metric("Total Sales", f"{total_sales:,.2f}")
b.metric("Total Profit", f"{total_profit:,.2f}")
c.metric("Total Orders", f"{total_orders:,.0f}")
d.metric("Items Sold", f"{total_quantity:,.0f}")

st.divider()

overview, products, shipping, quality = st.tabs([
    "📊 Overview",
    "🛍️ Products",
    "🚚 Shipping",
    "🔎 Data Quality"
])

with overview:
    st.subheader("Business Overview")

    left, right = st.columns(2)

    with left:
        if sales_col and category_col:
            sales_by_category = (
                filtered.groupby(category_col, dropna=False)[sales_col]
                .sum().nlargest(10).reset_index()
            )
            fig = px.bar(
                sales_by_category,
                x=category_col, y=sales_col,
                title="Top 10 Categories / Products by Sales",
                labels={category_col: "Category / Product",
                        sales_col: "Sales"}
            )
            fig.update_layout(template="plotly_dark")
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.warning("Sales or Category Name column not found.")

    with right:
        if sales_col and region_col:
            region_sales = (
                filtered.groupby(region_col, dropna=False)[sales_col]
                .sum().reset_index()
            )
            fig = px.pie(
                region_sales, names=region_col, values=sales_col,
                title="Sales by Region"
            )
            fig.update_layout(template="plotly_dark")
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.warning("Sales or Region column not found.")

    if date_col and sales_col:
        filtered[date_col] = pd.to_datetime(
            filtered[date_col], errors="coerce"
        )
        trend = filtered.dropna(subset=[date_col]).copy()
        if not trend.empty:
            trend["Month"] = trend[date_col].dt.to_period("M").astype(str)
            monthly = trend.groupby("Month")[sales_col].sum().reset_index()
            fig = px.line(
                monthly, x="Month", y=sales_col,
                markers=True, title="Monthly Sales Trend"
            )
            fig.update_layout(template="plotly_dark")
            st.plotly_chart(fig, use_container_width=True)

with products:
    st.subheader("Product Performance")
    if category_col and sales_col:
        product_summary = (
            filtered.groupby(category_col, dropna=False)
            .agg(
                Sales=(sales_col, "sum"),
                Records=(sales_col, "count")
            )
            .sort_values("Sales", ascending=False)
            .reset_index()
        )
        st.dataframe(product_summary, use_container_width=True)
    else:
        st.warning("Required product or sales columns were not found.")

    if profit_col and category_col:
        profit_summary = (
            filtered.groupby(category_col, dropna=False)[profit_col]
            .sum().nlargest(10).reset_index()
        )
        fig = px.bar(
            profit_summary, x=category_col, y=profit_col,
            title="Top 10 Products by Profit"
        )
        fig.update_layout(template="plotly_dark")
        st.plotly_chart(fig, use_container_width=True)

with shipping:
    st.subheader("Shipping & Delivery Analysis")
    left, right = st.columns(2)

    with left:
        if shipping_col:
            ship_counts = (
                filtered[shipping_col].fillna("Unknown")
                .value_counts().reset_index()
            )
            ship_counts.columns = ["Shipping Mode", "Orders"]
            fig = px.bar(
                ship_counts, x="Shipping Mode", y="Orders",
                title="Orders by Shipping Mode"
            )
            fig.update_layout(template="plotly_dark")
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.warning("Shipping Mode column not found.")

    with right:
        if delivery_col:
            delivery_counts = (
                filtered[delivery_col].fillna("Unknown")
                .value_counts().reset_index()
            )
            delivery_counts.columns = ["Delivery Status", "Count"]
            fig = px.pie(
                delivery_counts, names="Delivery Status", values="Count",
                title="Delivery Status Breakdown"
            )
            fig.update_layout(template="plotly_dark")
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.warning("Delivery Status column not found.")

    if late_col:
        late_values = filtered[late_col].value_counts(dropna=False)
        st.write("Late Delivery Risk Distribution")
        st.dataframe(
            late_values.rename_axis("Late Delivery Risk")
            .reset_index(name="Records"),
            use_container_width=True
        )

with quality:
    st.subheader("Data Quality Check")
    quality_data = pd.DataFrame({
        "Column": filtered.columns,
        "Missing Values": filtered.isna().sum().values,
        "Missing (%)": (
            filtered.isna().mean().values * 100
        ).round(2),
        "Data Type": filtered.dtypes.astype(str).values
    })
    st.metric("Total Rows", f"{len(filtered):,}")
    st.metric("Duplicate Rows", f"{filtered.duplicated().sum():,}")
    st.dataframe(quality_data, use_container_width=True)

    st.subheader("Dataset Preview")
    st.dataframe(filtered.head(100), use_container_width=True)

# Download filtered data
st.sidebar.download_button(
    "Download Filtered CSV",
    data=filtered.to_csv(index=False).encode("utf-8"),
    file_name="apl_logistics_filtered.csv",
    mime="text/csv"
)

st.caption("APL Logistics | Business Intelligence Dashboard")
