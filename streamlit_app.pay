import streamlit as st
import pandas as pd
import numpy as np
import plotly.express as px

st.set_page_config(
    page_title="APL Logistics Dashboard",
    page_icon="📦",
    layout="wide"
)

st.markdown("""
<style>
.stApp {background-color: #071426; color: white;}
[data-testid="stSidebar"] {background-color: #0D1D35;}
[data-testid="stMetric"] {
    background: #102746;
    border: 1px solid #2D4C72;
    padding: 12px;
    border-radius: 10px;
}
h1, h2, h3 {color: white !important;}
</style>
""", unsafe_allow_html=True)

st.title("📦 APL Logistics Dashboard")
st.caption("Sales | Customers | Products | Shipping | Discounts")

uploaded_file = st.sidebar.file_uploader(
    "Upload your CSV or Excel file",
    type=["csv", "xlsx", "xls"]
)

if uploaded_file is None:
    st.info("Please upload your APL Logistics dataset from the sidebar.")
    st.stop()

try:
    if uploaded_file.name.lower().endswith(".csv"):
        try:
            df = pd.read_csv(uploaded_file, encoding="utf-8-sig")
        except UnicodeDecodeError:
            uploaded_file.seek(0)
            df = pd.read_csv(uploaded_file, encoding="latin1")
    else:
        df = pd.read_excel(uploaded_file)
except Exception as e:
    st.error(f"Unable to read file: {e}")
    st.stop()

if df.empty:
    st.error("The uploaded file is empty.")
    st.stop()

df.columns = [str(c).strip() for c in df.columns]

def find_col(candidates):
    def norm(x):
        return "".join(ch.lower() for ch in str(x) if ch.isalnum())

    lookup = {norm(c): c for c in df.columns}

    for candidate in candidates:
        if norm(candidate) in lookup:
            return lookup[norm(candidate)]

    for candidate in candidates:
        for key, value in lookup.items():
            if norm(candidate) in key:
                return value

    return None

C = {
    "sales": find_col(["Sales", "Order Item Total", "Total Sales"]),
    "profit": find_col(["Order Profit Per Order", "Profit"]),
    "region": find_col(["Order Region", "Region"]),
    "country": find_col(["Order Country", "Country"]),
    "city": find_col(["Order City", "City"]),
    "product": find_col(["Product Name", "Product"]),
    "category": find_col(["Category Name", "Category"]),
    "customer": find_col(["Order Customer Id", "Customer Id"]),
    "quantity": find_col(["Order Item Quantity", "Quantity"]),
    "status": find_col(["Order Status", "Status"]),
    "shipping": find_col(["Shipping Mode", "Ship Mode"]),
    "discount": find_col(["Order Item Discount", "Discount"]),
    "discount_rate": find_col(["Order Item Discount Rate", "Discount Rate"]),
    "order_id": find_col(["Order Id", "Order ID"]),
    "date": find_col(["order date (DateOrders)", "Order Date"]),
    "price": find_col(["Product Price", "Unit Price"])
}

for key in ["sales", "profit", "quantity", "discount",
            "discount_rate", "price"]:
    col = C[key]
    if col:
        df[col] = pd.to_numeric(
            df[col].astype(str)
            .str.replace(",", "", regex=False)
            .str.replace("$", "", regex=False),
            errors="coerce"
        )

if C["date"]:
    df[C["date"]] = pd.to_datetime(df[C["date"]], errors="coerce")

if not C["sales"] and C["price"] and C["quantity"]:
    df["Calculated Sales"] = df[C["price"]] * df[C["quantity"]]
    C["sales"] = "Calculated Sales"

st.sidebar.header("Dashboard Filters")
filtered = df.copy()

for label, key in [
    ("Region", "region"),
    ("Country", "country"),
    ("Category", "category"),
    ("Product", "product"),
    ("Order Status", "status"),
    ("Shipping Mode", "shipping")
]:
    col = C[key]
    if col:
        options = sorted(filtered[col].dropna().astype(str).unique())
        selected = st.sidebar.multiselect(label, options)
        if selected:
            filtered = filtered[filtered[col].astype(str).isin(selected)]

if filtered.empty:
    st.warning("No data found. Please change the filters.")
    st.stop()
